{
  "name": "frontend-subtracker",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:e2e": "ng build --configuration production,e2e",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "node scripts/test-time-zones.mjs",
    "e2e": "playwright test",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
