# Copy to .env for local development. Neither .env nor .env.mydevil is committed.
#
# .env.mydevil is the template for ~/apps/subtracker/api/shared/.env on the server
# (uploaded by hand, chmod 600). Differences from the local values below:
#   MODE=PROD
#   PORT=<port from `devil port list`>
#   NODE_ENV=production
#   POSTGRES_* = the database created with `devil pgsql db add` (no POSTGRES_DATABASE_DEV)
#   DATABASE_AUTO_SYNCHRONIZATION=false   (true is rejected at startup in PROD)
#   CORS_ORIGINS=https://subtracker.jakubpietrzykowski.pl
#   FRONTEND_URL=https://subtracker.jakubpietrzykowski.pl
#   SESSION_COOKIE_DOMAIN=.jakubpietrzykowski.pl
#   SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD, SMTP_FROM_EMAIL and
#   NOTIFICATION_ADMINISTRATOR_MAIL are required (the app and migrations refuse to start)
#
# Value syntax: the server scripts load this file with `. .env` in /bin/sh and
# export it, so the app sees what sh produced. Keep each value plain
# (KEY=value, no spaces) or wrap it in single quotes (KEY='two words'). Never
# use $, `, ", \ or # unquoted. Generate passwords from letters and digits only,
# e.g. `openssl rand -hex 16`.

APPLICATION_NAME=subtracker-api
# DEV | PROD
MODE=DEV
PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=subtracker-adm
POSTGRES_PASSWORD=subtracker
# Reference database: changed only by migrations; the TypeORM CLI (migration:*) always uses it.
POSTGRES_DATABASE=subtracker-db
# Working database of the app in MODE=DEV (ignored in PROD).
POSTGRES_DATABASE_DEV=subtracker-db-dev
# Rebuild the -dev schema from entities on startup; only honoured in MODE=DEV.
DATABASE_AUTO_SYNCHRONIZATION=true
# Small pool: the MyDevil PostgreSQL server is shared.
POSTGRES_POOL_MAX=5

# Comma-separated list of allowed origins; "*" is rejected (credentials are enabled).
# The same list is trusted by the CSRF protection: every origin here may also send
# state-changing requests (POST, PUT, DELETE), so list only frontends you control.
# Locally: ng serve (4200) and the built SSR server (4000) that the browser e2e tests
# (frontend-subtracker, npm run e2e) need. Comma-separated, not a JSON array.
CORS_ORIGINS=http://localhost:4200,http://localhost:4000

# Bare origin of the frontend, the target of magic links; must be https in PROD.
FRONTEND_URL=http://localhost:4200
# Parent domain of the session cookie; required in PROD, ignored in DEV (host-only cookie).
SESSION_COOKIE_DOMAIN=

# Mail - user mail (magic link, trial reminders)
# Empty SMTP_HOST in DEV: mail goes to the console. A set host requires username, password and from email.
# SMTP_SECURE: false = STARTTLS on 587, true = TLS on 465
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SubTracker

# Mail - system notifications to the operator
# Empty NOTIFICATION_SMTP_HOST: operator mail uses the SMTP_* transporter. A set host requires
# username, password and from email. Empty NOTIFICATION_ADMINISTRATOR_MAIL in DEV: only logged.
NOTIFICATION_ADMINISTRATOR_MAIL=
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_FROM_EMAIL=

# Add the stack trace to logs of unexpected errors (default true). Query parameters and request
# bodies are never logged, whatever this is set to.
LOG_ERROR_STACKS=true

# Local only, not read by the app: default account for ../dev-local/test-session.mjs
# (create | seed | cleanup) when no e-mail argument is given. Leave empty in .env.mydevil.
DEV_USER_EMAIL=
