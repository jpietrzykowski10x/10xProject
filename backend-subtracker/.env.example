# Copy to .env for local development. Neither .env nor .env.mydevil is committed.
#
# .env.mydevil is the template for ~/apps/subtracker/api/shared/.env on the server
# (uploaded by hand, chmod 600). Differences from the local values below:
#   MODE=PROD
#   PORT=<port from `devil port list`>
#   NODE_ENV=production
#   POSTGRES_* = the database created with `devil pgsql db add` (no POSTGRES_DATABASE_DEV)
#   DATABASE_AUTO_SYNCHRONIZATION=false   (true is rejected at startup in PROD)
#   CORS_ORIGINS=https://subtracker.jakubpietrzykowski.pl

APPLICATION_NAME=subtracker-api
# DEV | PROD
MODE=DEV
PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=subtracker-adm
POSTGRES_PASSWORD=subtracker
# Reference database: changed only by migrations; the TypeORM CLI (migration:*) always uses it.
POSTGRES_DATABASE=subtracker-db
# Working database of the app in MODE=DEV (ignored in PROD).
POSTGRES_DATABASE_DEV=subtracker-db-dev
# Rebuild the -dev schema from entities on startup; only honoured in MODE=DEV.
DATABASE_AUTO_SYNCHRONIZATION=true
# Small pool: the MyDevil PostgreSQL server is shared.
POSTGRES_POOL_MAX=5

# Comma-separated list of allowed origins; "*" is rejected (credentials are enabled).
CORS_ORIGINS=http://localhost:4200

# Mail - user mail (magic link, trial reminders); used from S-01
# SMTP_SECURE: false = STARTTLS on 587, true = TLS on 465
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Mail - system notifications to the operator; used from S-01
NOTIFICATION_ADMINISTRATOR_MAIL=
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_FROM_EMAIL=
