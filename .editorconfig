# Editor configuration for the whole repo, see https://editorconfig.org
# frontend-subtracker/ has its own .editorconfig (root = true) with the same base and Angular extras.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
