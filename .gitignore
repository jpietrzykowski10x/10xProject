# 10x toolkit (synced, not tracked)
/.claude/skills/10x*
# Exception: .github/workflows/impl-review.yml takes this skill from origin/<base> with
# `git archive`, so a copy is committed. Still generated: refresh with `10x get m5l3`, never edit.
!/.claude/skills/10x-impl-review-ci/
# Skills from 10x lessons without the 10x- prefix (module 5), generated by the CLI as well.
/.claude/skills/pack-init/
/.claude/skills/setup-cicd/
/.claude/skills/tf-registry/
/.claude/.10x*

# Claude Code personal settings (local permissions, not shared)
/.claude/settings.local.json

# Agent-loop hooks runtime state (Stop fingerprints, locks)
/.claude/hooks/.state/

# Dependencies (both apps)
node_modules/

# Backend build & test output
/backend-subtracker/dist/
/backend-subtracker/coverage/
*.tsbuildinfo

# Secrets — keep example files tracked
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Editors & OS
.idea/
.DS_Store
Thumbs.db

# Leftover from a failed bootstrap run
/.bootstrap-scaffold/

fyi
# MyDevil deploy packages (both apps)
.mydevil/

# dev-local trial working directory (prune-backups-trial.sh)
/dev-local/.prune-trial/

# playwright-cli (/10x-e2e explores the app in a browser): snapshots and console logs may hold
# credentials or session data; no leading slash, the CLI writes it wherever it is started.
.playwright-cli/
